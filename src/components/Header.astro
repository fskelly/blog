---
import { title } from "../settings/settings.json";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const links = [
    { label: "Home", href: `${base}/` },
    { label: "Posts", href: `${base}/posts` },
    { label: "Self-hosting", href: `${base}/category/self-hosting` },
    { label: "Categories", href: `${base}/categories` },
    { label: "About", href: `${base}/about` },
];
---

<nav class="capsule-nav" aria-label="Primary navigation">
	<div class="nav-inner">
		<a href={`${base}/`} class="nav-logo" aria-label={`${title} home`}>
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<rect x="2" y="6" width="20" height="12" rx="6" stroke="currentColor" stroke-width="2"></rect>
				<circle cx="8" cy="12" r="2" fill="currentColor"></circle>
				<circle cx="16" cy="12" r="2" fill="currentColor"></circle>
			</svg>
			<span>{title}</span>
		</a>

		<div class="nav-links">
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
		</div>

		<div class="nav-actions">
			<a class="icon-button search-link" href={`${base}/search`} title="Search" aria-label="Search">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<circle cx="11" cy="11" r="8"></circle>
					<path d="m21 21-4.35-4.35"></path>
				</svg>
			</a>

			<div class="theme-capsule" aria-label="Color theme">
				<button class="theme-option" data-theme="auto" title="Use device theme" aria-label="Use device theme">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
				</button>
				<button class="theme-option" data-theme="light" title="Light theme" aria-label="Use light theme">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path></svg>
				</button>
				<button class="theme-option" data-theme="dark" title="Dark theme" aria-label="Use dark theme">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
				</button>
			</div>

			<button class="icon-button menu-button" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobile-menu">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
			</button>
		</div>
	</div>

	<div class="mobile-menu" id="mobile-menu">
		{links.map((link) => <a href={link.href}>{link.label}</a>)}
		<a href={`${base}/search`}>Search</a>
	</div>
</nav>

<style>
	.capsule-nav {
		position: sticky;
		top: 1rem;
		z-index: 1000;
		width: min(calc(100% - 2rem), 960px);
		margin: 1rem auto 0;
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.625rem 0.875rem 0.625rem 1.25rem;
		background: var(--nav-bg);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border: 1px solid var(--nav-border);
		border-radius: 999px;
		box-shadow: var(--shadow-md);
	}

	.nav-logo,
	.nav-links,
	.nav-actions,
	.theme-capsule {
		display: flex;
		align-items: center;
	}

	.nav-logo {
		gap: 0.5rem;
		color: var(--text-primary);
		font-weight: 700;
		white-space: nowrap;
	}

	.nav-links {
		gap: 1.25rem;
		margin-left: auto;
	}

	.nav-links a,
	.mobile-menu a {
		color: var(--text-secondary);
		font-size: 0.875rem;
		font-weight: 600;
	}

	.nav-links a:hover,
	.mobile-menu a:hover {
		color: var(--color-primary);
	}

	.nav-actions {
		gap: 0.5rem;
	}

	.icon-button,
	.theme-option {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 0;
		color: var(--text-tertiary);
		cursor: pointer;
	}

	.icon-button {
		width: 36px;
		height: 36px;
		padding: 0;
		background: transparent;
		border-radius: 50%;
	}

	.icon-button:hover {
		background: var(--bg-tertiary);
		color: var(--color-primary);
	}

	.theme-capsule {
		gap: 2px;
		padding: 3px;
		background: var(--bg-tertiary);
		border-radius: 999px;
	}

	.theme-option {
		width: 30px;
		height: 30px;
		padding: 0;
		background: transparent;
		border-radius: 50%;
	}

	.theme-option.active {
		background: var(--bg-primary);
		color: var(--color-primary);
		box-shadow: var(--shadow-sm);
	}

	.menu-button,
	.mobile-menu {
		display: none;
	}

	.mobile-menu {
		margin-top: 0.5rem;
		padding: 0.75rem 1.25rem;
		background: var(--nav-bg);
		backdrop-filter: blur(14px);
		border: 1px solid var(--nav-border);
		border-radius: 16px;
		box-shadow: var(--shadow-md);
	}

	.mobile-menu.open {
		display: grid;
		gap: 0.25rem;
	}

	.mobile-menu a {
		padding: 0.625rem 0;
	}

	@media (max-width: 760px) {
		.nav-links {
			display: none;
		}

		.menu-button {
			display: inline-flex;
		}
	}

	@media (max-width: 480px) {
		.capsule-nav {
			width: calc(100% - 1rem);
			top: 0.5rem;
			margin-top: 0.5rem;
		}

		.nav-inner {
			padding-left: 0.875rem;
		}

		.nav-logo span,
		.search-link {
			display: none;
		}
	}
</style>

<script>
	function initializeHeader() {
		const root = document.documentElement;
		const options = document.querySelectorAll<HTMLButtonElement>(".theme-option");
		const media = window.matchMedia("(prefers-color-scheme: dark)");

		function applyTheme(mode: string) {
			const effective = mode === "auto" ? (media.matches ? "dark" : "light") : mode;
			root.classList.toggle("dark", effective === "dark");
			root.dataset.theme = mode;
			localStorage.setItem("theme", mode);
			options.forEach((option) => option.classList.toggle("active", option.dataset.theme === mode));
		}

		applyTheme(localStorage.getItem("theme") || "auto");
		options.forEach((option) => option.addEventListener("click", () => applyTheme(option.dataset.theme || "auto")));
		media.addEventListener("change", () => {
			if ((localStorage.getItem("theme") || "auto") === "auto") applyTheme("auto");
		});

		const button = document.querySelector<HTMLButtonElement>(".menu-button");
		const menu = document.querySelector<HTMLElement>(".mobile-menu");
		button?.addEventListener("click", () => {
			const isOpen = menu?.classList.toggle("open") ?? false;
			button.setAttribute("aria-expanded", String(isOpen));
		});
	}

	initializeHeader();
</script>
