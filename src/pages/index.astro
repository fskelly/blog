---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HomePosts from "../components/HomePosts.astro";
import ColorScript from "../components/ColorScript.astro";
import Tags from "../components/Tags.astro";
import { title, subtitle } from "../settings/settings.json"
import authors from "../data/authors.json";
import getTags from "../scripts/getTags";
import getCategories from "../scripts/getCategories";

const posts = await getCollection("posts", (post) => !post.data.draft);
const tags = getTags(posts);
const categories = getCategories(posts);
const primaryAuthor = authors[0];
---

<!doctype html>
<html lang="en-us">
	<BaseHead title={title} description={subtitle} />
	<body>
		<Header title={title} />
		<main>
			<section class="hero">
				<p class="eyebrow">Cloud, code, and practical tinkering</p>
				<h1>{title}</h1>
				<p class="hero-description">{subtitle}</p>
				<p class="hero-bio">{primaryAuthor.bio}</p>
				<p>{primaryAuthor.intro}</p>
				<a class="about-link" href={`${import.meta.env.BASE_URL}/about`}>About me &rarr;</a>
			</section>

			<section class="recent-posts">
				<div class="section-heading">
					<h2>Recent posts</h2>
					<a href={`${import.meta.env.BASE_URL}/posts`}>View all &rarr;</a>
				</div>
				<HomePosts allPosts={posts} />
			</section>

			<section class="browse">
				<Tags tags={categories} all routePrefix="category" heading="Browse categories" symbol="@" />
				<Tags tags={tags} all heading="Browse tags" />
			</section>
		</main>
		<Footer />
		<ColorScript />
	</body>
</html>

<style>
	.hero {
		max-width: 720px;
		margin: 0 auto;
		padding: 3rem 0 4rem;
		text-align: center;
	}

	.eyebrow {
		margin-bottom: 0.75rem;
		color: var(--color-primary);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.hero h1 {
		margin-bottom: 0.75rem;
		color: var(--text-primary);
	}

	.hero-description {
		margin: 0 auto 1.5rem;
		color: var(--text-secondary);
		font-size: 1.2rem;
	}

	.hero-bio {
		margin-bottom: 0.5rem;
		color: var(--text-primary);
		font-weight: 700;
	}

	.hero p:not(.eyebrow, .hero-description, .hero-bio) {
		max-width: 640px;
		margin: 0 auto 1rem;
	}

	.about-link {
		display: inline-block;
		font-weight: 700;
	}

	.recent-posts {
		max-width: 720px;
		margin: 0 auto;
		padding: 2rem 0;
	}

	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.section-heading h2 {
		margin: 0;
	}

	.section-heading a {
		font-size: 0.8rem;
		font-weight: 700;
		white-space: nowrap;
	}

	.browse {
		max-width: 720px;
		margin: 1rem auto 0;
		padding-top: 1rem;
		border-top: 1px solid var(--border-color);
	}
</style>
