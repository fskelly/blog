---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Post from "../components/Post.astro";
import ColorScript from "../components/ColorScript.astro";

import { title, subtitle } from "../settings/settings.json"

let posts = await getCollection("posts", (post) => !post.data.draft);

posts = posts
	.sort(
		(a, b) =>
			new Date(b.data.updated || b.data.added).valueOf() -
			new Date(a.data.updated || a.data.added).valueOf(),
	);
---

<!doctype html>
<html lang="en-us">
	<BaseHead title={title} description={subtitle} />
	<body>
		<Header />
		<main>
			<header class="page-header">
				<p>Archive</p>
				<h1>All posts</h1>
				<span>Notes on Azure, automation, home technology, and whatever I am building next.</span>
			</header>
			<content>
				<ul class="posts-list">
					{
						posts.map(
							({
								url,
								data: { description, slug, title, tags, categories, added: date },
							}) => <Post {description} {date} {slug} {title} {tags} {categories} />
						)
					}
				</ul>
			</content>

			<p class="center">
				<a href={`${import.meta.env.BASE_URL}/rss.xml`}>Subscribe with RSS &rarr;</a>
			</p>
		</main>
		<Footer />
		<ColorScript />
	</body>
</html>

<style>
	main {
		max-width: 720px;
	}

	.page-header {
		margin-bottom: 3rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--border-color);
	}

	.page-header p {
		margin: 0 0 0.5rem;
		color: var(--color-primary);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.page-header h1 {
		margin-bottom: 0.75rem;
	}

	.page-header span {
		color: var(--text-secondary);
	}
</style>
